---
layout: null
permalink: /sitemap.json
---
{
  "site_domain": "jaycuthrell.com",
  "payload_type": "AEO_GEO_Sitemap_Index",
  "generated_at": "{{ site.time | date: '%Y-%m-%d' }}",
  "pages": [
    {%- assign pages_count = 0 -%}
    {%- for p in site.pages -%}
      {%- if p.url contains '.css' or p.url contains '.xml' or p.url contains '.txt' or p.url contains '404' -%}
        {%- continue -%}
      {%- endif -%}
      {%- if pages_count > 0 -%},{%- endif -%}
    {
      "url": "{{ p.url | absolute_url }}",
      "title": {{ p.title | default: "Jay Cuthrell" | jsonify }},
      "type": "{% if p.url == '/' %}root_hub{% else %}static_navigation{% endif %}"
    }
      {%- assign pages_count = pages_count | plus: 1 -%}
    {%- endfor -%}
  ]
}