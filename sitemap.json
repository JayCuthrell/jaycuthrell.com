---
layout: null
permalink: /sitemap.json
---
{
  "site_domain": "jaycuthrell.com",
  "payload_type": "AEO_GEO_Sitemap_Index",
  "generated_at": "{{ site.time | date: '%Y-%m-%d' }}",
  "pages": [
    {%- assign first_item = true -%}
    {%- for p in site.pages -%}
      {%- unless p.url contains '.css' or p.url contains '.xml' or p.url contains '.txt' or p.url contains '404' or p.url contains '.json' -%}
        {%- if first_item == false -%},{%- endif -%}{%- assign first_item = false -%}
    {
      "url": "{{ p.url | absolute_url }}",
      "title": {{ p.title | default: "Jay Cuthrell" | jsonify }},
      "type": "{% if p.url == '/' or p.url == '/index.html' %}root_hub{% else %}static_navigation{% endif %}"
    }
      {%- endunless -%}
    {%- endfor -%}
  ]
}